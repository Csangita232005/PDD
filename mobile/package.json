{
  "name": "sharebite-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:5000 tcp:5000 && expo start --android",
